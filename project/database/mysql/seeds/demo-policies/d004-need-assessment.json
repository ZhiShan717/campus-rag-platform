          "id": "c020",
          "version_id": "v005",
          "clause_no": "第一条",
          "section_path": "第一章 总则",
          "order_no": 1,
          "content": "家庭经济困难学生认定结果是申请国家助学金、国家励志奖学金和勤工助学岗位的前提条件。"
        },
        {
          "id": "c021",
          "version_id": "v005",
          "clause_no": "第二条",
          "section_path": "第二章 认定等级",
          "order_no": 2,
          "content": "认定结果分为特别困难、困难、一般困难三档，分别对应不同的资助力度。"
        },
        {
          "id": "c022",
          "version_id": "v005",
          "clause_no": "第三条",
          "section_path": "第三章 申请材料",
          "order_no": 3,
          "content": "申请学生须提交家庭经济情况说明及相应证明材料，并对材料真实性负责，提供虚假材料者取消当年认定资格。"
        },
        {
          "id": "c023",
          "version_id": "v005",
          "clause_no": "第四条",
          "section_path": "第四章 认定程序",
          "order_no": 4,
          "content": "每年 9 月集中受理认定申请，班级评议、学院审核后公示 5 个工作日。"
        },
        {
          "id": "c024",
          "version_id": "v005",
          "clause_no": "第五条",
          "section_path": "第五章 结果管理",
          "order_no": 5,
          "content": "认定结果有效期为一个学年，家庭经济状况发生重大变化的，可随时申请复核。"
        }
      ]
    }
  ]
}
