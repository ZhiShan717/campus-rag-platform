      "chunks": [
        {
          "id": "c025",
          "version_id": "v006",
          "clause_no": "第一条",
          "section_path": "第一章 总则",
          "order_no": 1,
          "content": "为资助家庭经济困难学生的生活费用开支，学校设立国家助学金。"
        },
        {
          "id": "c026",
          "version_id": "v006",
          "clause_no": "第二条",
          "section_path": "第二章 资助标准",
          "order_no": 2,
          "content": "国家助学金平均每人每年 3300 元，按困难等级分档发放。"
        },
        {
          "id": "c027",
          "version_id": "v006",
          "clause_no": "第三条",
          "section_path": "第三章 申请条件",
          "order_no": 3,
          "content": "申请学生须已通过家庭经济困难认定，且在校期间无纪律处分记录。"
        },
        {
          "id": "c028",
          "version_id": "v006",
          "clause_no": "第四条",
          "section_path": "第四章 发放方式",
          "order_no": 4,
          "content": "国家助学金按学期分两次发放至学生本人银行卡，不得由他人代领。"
        }
      ]
    }
  ]
